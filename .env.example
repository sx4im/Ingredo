# Optional — `chronos explain` summarizes a failure capsule with an LLM.
# The command is fully optional and degrades to a no-op when nothing is set.
# Set ONE of these; they are probed in this order.
#
# NEVER commit real values. `.env` is gitignored; this file is the template.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Or point at any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM,
# OpenRouter, Groq, ...). https is required for any non-loopback host — the key
# is sent as a bearer token.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
